number = int(input("Введите трехзначное число: "))

# Получаем каждую цифру
# Например, для 345:
digit1 = number // 100           # Первая цифра (345 // 100 = 3)
digit2 = (number // 10) % 10     # Вторая цифра (345 // 10 = 34; 34 % 10 = 4)
digit3 = number % 10             # Третья цифра (345 % 10 = 5)

# Вычисление суммы и произведения
digits_sum = digit1 + digit2 + digit3
digits_product = digit1 * digit2 * digit3

print(f"Сумма цифр: {digits_sum}")
print(f"Произведение цифр: {digits_product}")
